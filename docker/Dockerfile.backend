# Dockerfile for AgriNova FastAPI Backend
FROM python:3.12-slim

# Install OS system dependencies for PostGIS, GDAL, and build utilities
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    gdal-bin \
    libgdal-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy requirements and install Python packages
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application backend & modules
COPY backend/ /app/
COPY ai-engine/ /app/ai-engine/
COPY earth-engine/ /app/earth-engine/
COPY weather-service/ /app/weather-service/

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
