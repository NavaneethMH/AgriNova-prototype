# ============================================================
# AgriNova Environment Variables
# Copy this file to .env and fill in your actual values.
# ============================================================

# ---- Application ----
APP_NAME=AgriNova
APP_ENV=development
DEBUG=true
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Database (PostgreSQL + PostGIS) ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agrinova
DB_USER=agrinova_user
DB_PASSWORD=agrinova_password
DATABASE_URL=postgresql+asyncpg://agrinova_user:agrinova_password@localhost:5432/agrinova

# ---- Backend API ----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_NAME=AgriNova
VITE_APP_ENV=development

# ---- OpenWeather API ----
# Get your free key at: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5

# ---- Google Earth Engine ----
# Path to your GEE service account JSON credentials file
# Leave empty to use simulated satellite data fallback
GEE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GEE_CREDENTIALS_PATH=./earth-engine/gee_credentials.json
GEE_PROJECT_ID=your-gcp-project-id
# Set to "true" to force simulated data even if credentials exist
GEE_USE_SIMULATION=true

# ---- Redis (for caching & background tasks) ----
REDIS_URL=redis://localhost:6379/0

# ---- Rate Limiting ----
RATE_LIMIT_PER_MINUTE=60

# ---- Logging ----
LOG_LEVEL=INFO

# ---- CORS ----
CORS_ALLOW_CREDENTIALS=true
