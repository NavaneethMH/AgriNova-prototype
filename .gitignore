# ========================
# AgriNova .gitignore
# ========================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/
.eggs/
*.egg-link
*.pth

# Virtual environments
.venv/
venv/
env/
ENV/
.env
.env.local
.env.*.local
backend/.env
weather-service/.env
ai-engine/.env
earth-engine/.env

# Keep example env files
!.env.example
!**/.env.example

# Node / Frontend
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# TypeScript
*.tsbuildinfo

# IDE
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Docker
docker/data/
.docker/

# Database
*.sqlite3
*.db
postgres_data/

# Google Earth Engine credentials
gee_credentials.json
service_account.json

# Alembic
database/migrations/versions/__pycache__/

# ML Models (large files)
ai-engine/models/*.pkl
ai-engine/models/*.joblib
!ai-engine/models/.gitkeep

# Coverage
.coverage
htmlcov/
.pytest_cache/
coverage.xml

# Logs
logs/
*.log

# Temporary files
tmp/
temp/
.temp/
